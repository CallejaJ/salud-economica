# Copy to .env.local for local development.
# On Vercel, set them in Project Settings → Environment Variables (Production and Preview).

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://salud-economica.vercel.app

# --- Claude API (server only) ---
# Used by /api/statement to sort bank statement transactions. Never exposed to the browser.
# Optional: without it, PDF import falls back to the built-in regex reader.
ANTHROPIC_API_KEY=sk-ant-your-key
